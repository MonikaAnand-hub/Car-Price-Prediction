        "Car_Age": 8,
        "Fuel_Type": "Petrol",
        "Seller_Type": "Dealer",
        "Transmission": "Manual",
        "Owner": 0
    }
])

predicted_price = best_model.predict(new_car)[0]

print("\nNew Car Details:")
print(new_car)

print(
